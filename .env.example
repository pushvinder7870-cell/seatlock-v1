# Copy to .env.local for local development (npm run localdb:setup writes the DB line for you).

# --- Required ---------------------------------------------------------------
# PostgreSQL 16+. Local, Docker, Supabase or Neon all work.
DATABASE_URL=postgresql://seatlock:seatlock_password@localhost:5432/seatlock
# HMAC key for session tokens and CSRF tokens. Use 32+ random characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# --- Hosted database --------------------------------------------------------
# Supabase: use the "Transaction pooler" URI (port 6543) WITHOUT ?sslmode=...
# and set DATABASE_SSL=no-verify. Neon: keep its URL and leave this unset.
# DATABASE_SSL=no-verify
# DB_POOL_MAX=5                      # keep small on serverless (Vercel)

# --- AI features (optional, Claude) -----------------------------------------
# Ask SeatLock assistant, AI review summaries, "Write with AI". Get a key at
# https://console.anthropic.com → API keys. Server-side only; never NEXT_PUBLIC_.
# ANTHROPIC_API_KEY=sk-ant-...

# --- Image uploads (optional, Supabase Storage) -----------------------------
# Without these, uploaded images are stored in PostgreSQL (works everywhere).
# Create a PUBLIC bucket named "post-images". The key stays on the server.
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ...   # Project Settings → API → service_role (secret!)
# SUPABASE_BUCKET=post-images

# --- Optional ---------------------------------------------------------------
# APP_TIME_ZONE=Asia/Kolkata         # time zone used to display/enter event times
# COOKIE_SECURE=false                # only for plain-HTTP demos; defaults to true in production
# HOLD_SWEEP_INTERVAL_MS=15000
